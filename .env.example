# PontoPro: variáveis de ambiente de desenvolvimento/produção
# Nunca publique valores reais neste arquivo nem os envie ao Git.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Em desenvolvimento, configure o proprietário pela tela local. Em produção, defina PONTOPRO_OWNER_EMAIL e PONTOPRO_OWNER_PASSWORD no painel de segredos.
# SESSION_SECRET será usado quando as sessões compartilhadas de produção forem integradas.
SESSION_SECRET=
PONTOPRO_OWNER_EMAIL=
PONTOPRO_OWNER_PASSWORD=
PONTOPRO_DATA_DIR=

# Banco compartilhado gerenciado para implantação multi-instância (adapter PostgreSQL ainda deve ser configurado antes de usar serverless).
DATABASE_URL=

# Política de retenção (dias); validar com jurídico/encarregado LGPD antes de ativar exclusão automática.
PONTOPRO_EVIDENCE_RETENTION_DAYS=365

# Chaves já usadas pela interface/integrações existentes


# Asaas — manter em sandbox até concluir testes de ponta a ponta.
# ASAAS_ENVIRONMENT=sandbox (use production somente após validação e aprovação comercial)
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
# Token exclusivo configurado no painel de Webhooks do Asaas (não reutilizar a API Key).
ASAAS_WEBHOOK_TOKEN=

# Só habilitar após concluir testes de Sandbox e validar webhooks.
BILLING_ENFORCEMENT_ENABLED=false
